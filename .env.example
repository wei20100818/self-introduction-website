# Public website URL (the GitHub Pages site)
SITE_ORIGIN=https://wei20100818.github.io/self-introduction-website

# Public Vercel URL for this API, e.g. https://your-project.vercel.app
API_ORIGIN=

# stage for testing; change to production only after ECPay approves the live merchant account.
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# Set this same value in GitHub Actions Variables so the static site knows where to submit payments.
VITE_PAYMENT_API_ORIGIN=
